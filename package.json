{
  "name": "vermietluchs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Leichtgewichtige Verwaltung von Mietobjekten und Betriebskosten",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.5": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "e2e:server": "tsx tests/e2e/server.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "9.1.2",
    "esbuild": "0.25.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
